# Copie este arquivo para ".env" (na mesma pasta) e preencha. O Bun lê o .env sozinho.

# Chave PRIVADA que assina as licenças. Gere com:  bun run gerar-chaves
# Nunca mande esta chave pra ninguém nem coloque no exe — só a chave PÚBLICA vai no app.
LICENSE_PRIVATE_KEY=

# Porta em que o servidor escuta (atrás de um proxy com HTTPS — ver README).
PORT=8787

# Pasta onde ficam os dados (usuários, convites, chaves, sessões). Faça backup dela.
DATA_DIR=./data

# Por quantas horas o programa do cliente continua funcionando sem conseguir falar com este servidor.
OFFLINE_GRACE_HOURS=24
