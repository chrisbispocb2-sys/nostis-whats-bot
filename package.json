{
  "name": "nostis-whats-bot",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build:web": "bun build ./src/web/main.js --outfile ./src/web/dist/app.txt --minify",
    "build": "bun run build:web && bun run scripts/build-exe.ts",
    "start": "bun run build:web && bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "^22.20.3",
    "@types/qrcode": "1.5.6"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "baileys-joss": "2.0.1",
    "notifier-hook": "^1.0.0",
    "pino": "^10.3.1",
    "qrcode": "1.5.4"
  }
}
